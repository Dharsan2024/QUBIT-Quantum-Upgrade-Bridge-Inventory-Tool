# --- Secrets / keys / env (never commit real ones) ---
.env
.env.*
!.env.example              # the template (no real creds) IS committed
*.pem
*.key
*.jks
*.p12
*.pfx
!tests/fixtures/**          # deliberately-vulnerable fixtures are intentional
!demo-lab/**               # demo-lab keys are generated + deliberately weak

# --- Editor / OS ---
.obsidian/
*.base
*.canvas
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Agent scratch ---
.claude/
# Holds live MCP server credentials (e.g. an X-Goog-Api-Key for Stitch). Never commit.
.agents/

# Reproducible synthetic corpora (regenerate: qubit risk gen-dataset)
datasets/

# --- Local reference material (not part of the product, not vendored) ---
# Third-party repos cloned for design research (see docs/design/07-ecosystem-factcheck.md).
# Each contains its own nested .git — never stage this.
git help/

# ── Local demo-lab scanning targets (not pushed) ──────────────────────────────
