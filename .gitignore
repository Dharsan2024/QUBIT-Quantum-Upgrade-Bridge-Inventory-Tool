# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- uv ---
# uv.lock IS committed (reproducibility) — do not ignore it.

# --- Node / dashboard ---
node_modules/
dashboard/dist/
dashboard/.vite/
*.tsbuildinfo

# --- QUBIT runtime artifacts ---
*.db
*.db-wal
*.db-shm
*.db.bak-*
out/
experiments/results/**/*.csv
experiments/results/**/*.png
# ML artifacts: ignore by default, but the shipped models (via Git LFS for the big ones) are
# tracked so the repo is self-contained. Disposable training checkpoints stay ignored.
models/*
!models/MANIFEST.sha256
!models/risk-xgboost/
!models/sensitivity-distilbert/
models/sensitivity-distilbert/checkpoint-*/
demo-lab/certs/
*.pcap
*.pcapng
!tests/fixtures/**/*.pcap   # committed golden pcaps are intentional

# --- Secrets / keys / env (never commit real ones) ---
.env
.env.*
!.env.example              # the template (no real creds) IS committed
*.pem
*.key
*.jks
*.p12
*.pfx
!tests/fixtures/**          # deliberately-vulnerable fixtures are intentional
!demo-lab/**               # demo-lab keys are generated + deliberately weak

# --- Editor / OS ---
unwanted/.obsidian/
*.base
*.canvas
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Agent scratch ---
.claude/
# Holds live MCP server credentials (e.g. an X-Goog-Api-Key for Stitch). Never commit.
.agents/

# Reproducible synthetic corpora (regenerate: qubit risk gen-dataset)
datasets/

# --- Local reference material (not part of the product, not vendored) ---
# Third-party repos cloned for design research (see docs/design/07-ecosystem-factcheck.md).
# Each contains its own nested .git — never stage this.
git help/

# Reference material downloaded for authoring, not part of the project.
unwanted/"design skills"/
unwanted/design skills/

# ── Local demo-lab scanning targets (not pushed) ──────────────────────────────
# One deliberately-vulnerable application: the MediVault digital twin, the fixture the migration
# results rest on. The other nineteen targets were deleted; `vulnapp-python` went with them and
# every reference to it (bridge CLI default, bridge demo, cli demo, both compose files, the
# nginx upstream, the compliance e2e) now points at `medivault-emr` on port 5001.
#
# NOTE: this line means the twin is UNTRACKED. It is now the artefact
# `qubit-v2/08-evaluation/RESULTS-digital-twin.md` depends on, so a reviewer cannot reproduce
# those numbers from the repository. Left as-is because keeping demo-lab local was a deliberate
# choice; remove this line to track it.
demo-lab/medivault-emr/

# --- benchmark oracles ---
# Semgrep registry rules are LGPL-2.1 and are fetched, not vendored: only their sha256 manifest is
# committed, so a run can prove which rules produced a number without redistributing them.
benchmarks/oracles/rulesets/*.yaml
!benchmarks/oracles/rulesets/MANIFEST.sha256
# Stray editor build downloaded into the tree.
*.vsix

# Benchmark oracle binaries: a 50 MB plugin jar, fetched by benchmarks/oracles/sonar_oracle.py
benchmarks/oracles/vendor/

# Paper evidence pack: regenerated artifacts, not source
paper_evidence/data/raw/

paper_evidence/scripts/__pycache__/

# Filed out of the working tree: notes, design references and editor/agent config.
# See unwanted/README.md for what is in there and what was deliberately left in place.
unwanted/

# Deliberately local: the vulnerable sample apps used for demos and manual testing.
demo-lab/

# Coverage artifacts
.coverage

# Deployment and environment scaffolding: kept local (see unwanted/deployment/).
Dockerfile.api
docker-compose.yml
.env.example
.env

# Design docs and internal specification: kept local (see unwanted/docs/).
docs/

# Bridge output: `qubit_bridge.compose` creates this at runtime.
generated/

# One-off Playwright drivers written while verifying a change through the real app. They are
# session scratch, not project code — the durable browser tests live in dashboard/e2e/.
# The glob covers their logs, JSON output and the PID lock file they mutex on, not just the
# scripts: a stale `.tmp_driver.lock` committed by accident would block the next run.
dashboard/.tmp_*
dashboard/_qubit_*_tmp.mjs
# Measurement output from those drivers (A/B comparisons between generation engines). Session
# evidence, quoted in the write-up rather than kept — the durable record is the plan file.
dashboard/ab_*.json

# ── Digital-twin migration output ─────────────────────────────────────────────
# `scripts/twin_migrate.py` copies `demo-lab/medivault-emr` here and migrates the copy. The copy and
# its scratch database are derived and regenerable; the REPORT is the artefact quoted in
# `qubit-v2/08-evaluation/RESULTS-digital-twin.md`, so it is kept.
test-output/*/medivault-emr/
test-output/*/*.db

# ── Local scratch, research output and evaluation artefacts (not pushed) ──────
# None of this is source. It is either generated by a run, cloned for research, or a working
# document that belongs to the paper rather than to the tool.
.obsidian/
graphify-out/
output/
test-output/
pqc-migration-bench/
qubit-v2/
