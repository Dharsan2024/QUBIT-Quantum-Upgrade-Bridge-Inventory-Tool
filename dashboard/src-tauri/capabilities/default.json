{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "QUBIT desktop core permissions",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-text-file"
  ]
}
